---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE, SITE_CITY, SITE_COORDS, SITE_START_DATE, SITE_REPO } from '../consts';
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main {
				padding-top: 4em;
				padding-bottom: 6em;
			}
			.hero {
				text-align: center;
			}
			.hero h1 {
				font-size: 3.2em;
				margin-bottom: 0.3em;
				background: var(--accent-gradient);
				-webkit-background-clip: text;
				background-clip: text;
				color: transparent;
				line-height: 1.2;
			}
			.hero .tagline {
				font-size: 1.25em;
				color: var(--text);
				margin-bottom: 2.5em;
			}
			.cursor::after {
				content: '▍';
				color: var(--accent);
				animation: blink 1.2s step-end infinite;
			}
			@keyframes blink {
				50% {
					opacity: 0;
				}
			}
			.cta {
				display: inline-flex;
				gap: 1em;
				flex-wrap: wrap;
				justify-content: center;
			}
			.btn {
				display: inline-block;
				padding: 0.7em 1.8em;
				border-radius: 999px;
				text-decoration: none;
				font-weight: 600;
				transition: 0.25s ease;
				border: 1px solid var(--border-strong);
				color: var(--text-bright);
			}
			.btn:hover {
				border-color: var(--accent);
				box-shadow: var(--glow);
				transform: translateY(-2px);
				color: var(--accent);
				text-shadow: none;
			}
			.btn.primary {
				background: var(--accent-gradient);
				color: #041018;
				border: none;
			}
			.btn.primary:hover {
				filter: brightness(1.15);
				color: #041018;
				box-shadow: 0 0 28px rgba(0, 240, 255, 0.35);
			}
			/* ---------- 状态面板 ---------- */
			.status-panel {
				max-width: 560px;
				margin: 3em auto 0;
				background: #0d1220;
				border: 1px solid var(--border);
				border-radius: 16px;
				box-shadow: var(--box-shadow);
				overflow: hidden;
				text-align: left;
			}
			.status-panel .bar {
				display: flex;
				align-items: center;
				gap: 8px;
				padding: 10px 16px;
				background: var(--bg-elevated);
				border-bottom: 1px solid var(--border);
				font-size: 0.85em;
				color: var(--text-dim);
			}
			.status-panel .bar .dots { display: flex; gap: 6px; }
			.status-panel .bar span.dot { width: 12px; height: 12px; border-radius: 50%; }
			.status-panel .bar span.dot:nth-child(1) { background: #ff5f57; }
			.status-panel .bar span.dot:nth-child(2) { background: #febc2e; }
			.status-panel .bar span.dot:nth-child(3) { background: #28c840; }
			.status-panel .bar .title { margin-left: 8px; }
			.status-panel .body { padding: 1.4em 1.6em; }
			.status-row {
				display: flex;
				align-items: center;
				gap: 0.8em;
				padding: 0.55em 0;
				border-bottom: 1px dashed rgba(0, 240, 255, 0.08);
				font-size: 0.98em;
			}
			.status-row:last-child { border-bottom: none; }
			.status-row .icon { width: 1.6em; text-align: center; font-size: 1.15em; }
			.status-row .label { color: var(--text-dim); min-width: 4em; }
			.status-row .value { color: var(--text-bright); }
			.status-row .value.big { font-size: 1.3em; font-weight: 700; letter-spacing: 0.05em; font-variant-numeric: tabular-nums; }
			.like-btn {
				display: inline-flex;
				align-items: center;
				gap: 0.5em;
				padding: 0.4em 1.1em;
				border-radius: 999px;
				border: 1px solid rgba(255, 95, 135, 0.45);
				color: #ff8fa3;
				cursor: pointer;
				background: transparent;
				transition: 0.2s;
				font-size: 0.92em;
				text-decoration: none;
			}
			.like-btn:hover {
				border-color: #ff5f87;
				box-shadow: 0 0 16px rgba(255, 95, 135, 0.25);
				transform: translateY(-1px);
			}
			.like-btn.liked { background: rgba(255, 95, 135, 0.15); }
			.status-list { margin-top: 0.4em; }
			.status-list .item {
				padding: 0.7em 0.9em;
				margin-top: 0.7em;
				background: rgba(22, 30, 48, 0.5);
				border: 1px solid rgba(0, 240, 255, 0.1);
				border-radius: 10px;
				font-size: 0.95em;
			}
			.status-list .item .meta { color: var(--text-dim); font-size: 0.78em; margin-bottom: 0.35em; }
			.section-title {
				margin-top: 1.4em;
				padding-top: 1em;
				border-top: 1px solid rgba(0, 240, 255, 0.12);
				color: var(--accent);
				font-size: 0.9em;
				font-weight: 600;
				letter-spacing: 0.08em;
			}
			.life-link { display: block; margin-top: 1.2em; text-align: center; font-size: 0.9em; color: var(--text-dim); }
			.life-link a { color: var(--accent); text-decoration: none; }
			.life-link a:hover { text-decoration: underline; }
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<h1>{SITE_TITLE}</h1>
				<p class="tagline cursor">技术折腾与生活记录，都写在这里。</p>
				<div class="cta">
					<a class="btn primary" href="/buyu/blog">进入博客 →</a>
					<a class="btn" href="/buyu/about">关于我</a>
				</div>

				<div class="status-panel">
					<div class="bar">
						<div class="dots"><span class="dot"></span><span class="dot"></span><span class="dot"></span></div>
						<span class="title">▸ 当前状态</span>
					</div>
					<div class="body">
						<div class="status-row">
							<span class="icon">🕐</span>
							<span class="label">时间</span>
							<span class="value big" id="clock">--:--:--</span>
						</div>
						<div class="status-row">
							<span class="icon">📅</span>
							<span class="label">日期</span>
							<span class="value" id="date">----</span>
						</div>
						<div class="status-row">
							<span class="icon">📍</span>
							<span class="label">地点</span>
							<span class="value">{SITE_CITY}</span>
						</div>
						<div class="status-row">
							<span class="icon" id="weather-icon">🌡️</span>
							<span class="label">天气</span>
							<span class="value" id="weather">加载中...</span>
						</div>
						<div class="status-row">
							<span class="icon">🎂</span>
							<span class="label">站龄</span>
							<span class="value" id="days">--</span>
						</div>
						<div class="status-row">
							<span class="icon">👀</span>
							<span class="label">访问</span>
							<span class="value">
								<span id="busuanzi_value_site_pv">--</span> 次 &nbsp;·&nbsp;
								<span id="busuanzi_value_site_uv">--</span> 人
							</span>
						</div>
						<div class="status-row">
							<span class="icon">❤️</span>
							<span class="label">点赞</span>
							<a class="like-btn" id="like-btn" href="https://github.com/{SITE_REPO}" target="_blank" rel="noopener">
								⭐ <span id="star-count">--</span> · 去 GitHub 点个赞
							</a>
						</div>

						<div class="section-title">💬 最近状态</div>
						<div class="status-list" id="status-list">
							<div class="hint" style="color:var(--text-dim);font-size:0.85em;">加载中...</div>
						</div>

						<div class="life-link">🔒 <a href="/buyu/life">进入生活圈</a>（密码：作者生日）</div>
					</div>
				</div>
			</section>
		</main>
		<Footer />

		<script is:inline src="https://busuanzi.ibruce.info/busuanzi/2.3/busuanzi.pure.mini.js" async></script>
		<script is:inline>
			// ===== 时钟 =====
			function tick() {
				const now = new Date();
				const pad = (n) => String(n).padStart(2, '0');
				document.getElementById('clock').textContent =
					pad(now.getHours()) + ':' + pad(now.getMinutes()) + ':' + pad(now.getSeconds());
				document.getElementById('date').textContent =
					now.getFullYear() + '年' + (now.getMonth() + 1) + '月' + now.getDate() + '日 ' +
					['周日', '周一', '周二', '周三', '周四', '周五', '周六'][now.getDay()];
			}
			tick();
			setInterval(tick, 1000);

			// ===== 网站存在天数 =====
			(function () {
				const start = new Date('{SITE_START_DATE}');
				const today = new Date();
				const days = Math.floor((today - start) / 86400000) + 1;
				document.getElementById('days').textContent = '不语已陪伴 ' + days + ' 天';
			})();

			// ===== 天气（Open-Meteo，佛山） =====
			(function () {
				const lat = 23.02, lon = 113.12; // 佛山坐标
				const iconMap = {
					0: ['☀️', '晴'], 1: ['🌤️', '晴间多云'], 2: ['⛅', '多云'], 3: ['☁️', '阴'],
					45: ['🌫️', '雾'], 48: ['🌫️', '雾凇'],
					51: ['🌦️', '毛毛雨'], 53: ['🌦️', '毛毛雨'], 55: ['🌦️', '毛毛雨'],
					56: ['🌧️', '冻雨'], 57: ['🌧️', '冻雨'],
					61: ['🌧️', '小雨'], 63: ['🌧️', '中雨'], 65: ['🌧️', '大雨'],
					66: ['🌧️', '冻雨'], 67: ['🌧️', '冻雨'],
					71: ['❄️', '小雪'], 73: ['❄️', '中雪'], 75: ['❄️', '大雪'], 77: ['🌨️', '雪粒'],
					80: ['🌦️', '阵雨'], 81: ['🌧️', '阵雨'], 82: ['⛈️', '强阵雨'],
					85: ['🌨️', '阵雪'], 86: ['🌨️', '强阵雪'],
					95: ['⛈️', '雷阵雨'], 96: ['⛈️', '雷阵雨伴冰雹'], 99: ['⛈️', '雷阵雨伴冰雹']
				};
				fetch('https://api.open-meteo.com/v1/forecast?latitude=' + lat + '&longitude=' + lon +
					'&current_weather=true&timezone=Asia%2FShanghai')
					.then(r => r.json())
					.then(d => {
						const w = d.current_weather;
						const code = w.weathercode;
						const [icon, desc] = iconMap[code] || ['🌡️', '未知'];
						document.getElementById('weather-icon').textContent = icon;
						document.getElementById('weather').textContent =
							desc + ' ' + Math.round(w.temperature) + '°C';
					})
					.catch(() => {
						document.getElementById('weather').textContent = '天气获取失败';
					});
			})();

			// ===== 点赞（GitHub Star 数） =====
			(function () {
				fetch('https://api.github.com/repos/{SITE_REPO}')
					.then(r => r.json())
					.then(d => {
						document.getElementById('star-count').textContent = (d.stargazers_count ?? 0) + ' ⭐';
					})
					.catch(() => {
						document.getElementById('star-count').textContent = '去点赞';
					});
			})();

			// ===== 最近状态（public/status.json） =====
			(function () {
				fetch('/buyu/status.json')
					.then(r => r.json())
					.then(d => {
						const list = (d.statuses || []).slice(-5).reverse();
						const el = document.getElementById('status-list');
						if (!list.length) {
							el.innerHTML = '<div style="color:var(--text-dim);font-size:0.85em;">还没有状态</div>';
							return;
						}
						el.innerHTML = '';
						list.forEach(s => {
							const item = document.createElement('div');
							item.className = 'item';
							item.innerHTML = '<div class="meta">' + s.date + ' ' + s.time + '</div><div>' +
								s.content.replace(/</g, '&lt;') + '</div>';
							el.appendChild(item);
						});
					})
					.catch(() => {
						document.getElementById('status-list').innerHTML =
							'<div style="color:var(--text-dim);font-size:0.85em;">状态加载失败</div>';
					});
			})();
		</script>
	</body>
</html>
